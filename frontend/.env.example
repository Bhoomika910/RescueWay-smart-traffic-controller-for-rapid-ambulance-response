# RescueWay frontend configuration.
# Copy to `.env` and adjust; Vite only exposes VITE_-prefixed vars to
# client code (see src/api/rescueway.js / src/App.jsx for where this is
# read). Falls back to http://127.0.0.1:8000 if unset, so this file is
# optional for plain local development against a backend on localhost:8000.

VITE_API_BASE_URL=http://127.0.0.1:8000
