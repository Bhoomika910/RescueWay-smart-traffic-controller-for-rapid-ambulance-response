# RescueWay backend configuration.
# Copy to `.env` (kept out of git — see .gitignore) and adjust as needed.
# Every value here has a safe default baked into config.py; nothing in this
# file is required to run the server locally. Docker Compose reads this
# file automatically via `env_file: .env` (see docker-compose.yml).

# ─── Server ───────────────────────────────────────────
RESCUEWAY_HOST=0.0.0.0
RESCUEWAY_PORT=8000
# Comma-separated list of allowed CORS origins for the dashboard.
RESCUEWAY_FRONTEND=http://localhost:5173,http://localhost:5174

# ─── API authentication ───────────────────────────────
# Leave blank to disable auth (fine for local dev — see routers/auth.py).
# Set to a long random value before exposing this server beyond localhost.
# Required header on protected routes: X-API-Key: <value>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESCUEWAY_API_KEY=

# ─── Arduino hardware ─────────────────────────────────
# Serial port the traffic-light controller is attached to. Irrelevant when
# running in Docker without a mounted serial device — the backend falls
# back to simulation mode automatically if the port can't be opened.
RESCUEWAY_ARDUINO_PORT=COM3
RESCUEWAY_ARDUINO_BAUD=9600

# ─── Benchmark / reproducibility ──────────────────────
RESCUEWAY_BENCHMARK_SEED=42

# ─── Metrics windows ───────────────────────────────────
RESCUEWAY_METRICS_WINDOW=100
RESCUEWAY_EMERGENCY_WINDOW=200

# ─── Sensor noise model (see noise/noise_models.py) ────
# All optional; unset = no injected noise (clean conditions).
# RESCUEWAY_NOISE_SENSOR_GAUSSIAN_STD=0.0
# RESCUEWAY_NOISE_GPS_MISCLASS_PROB=0.0

# Database path (Render persistent disk)
# Leave unset for local development.
RESCUEWAY_DB_PATH=
